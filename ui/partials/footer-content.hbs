{{!-- ui/partials/footer-content.hbs --}}
{{#if page.component}}
<section class="doc-feedback">
  <h2>Feedback</h2>
  <script defer src="{{#if site.keys.comentarioUrl}}{{site.keys.comentarioUrl}}{{else}}{{site.keys.comentario_url}}{{/if}}/comentario.js"></script>
  <comentario-comments theme="auto"></comentario-comments>
</section>
{{/if}}
<script src="{{{uiRootPath}}}/js/mermaid.min.js"></script>
<script>
  if (window.mermaid) {
    mermaid.initialize({ startOnLoad: true, theme: 'default', securityLevel: 'loose' });
  }
</script>
<footer class="footer"><p>XPO Docs Hub</p></footer>
